---
import ExerciseList from "../../components/ExerciseList.svelte";
import AuthBar from "../../components/auth/AuthBar.svelte";

export const prerender = false;

const { id } = Astro.params;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Exercises</title>
  </head>
  <body>
    <AuthBar client:visible />
    <ExerciseList client:only="svelte" languageId={id} />
  </body>
</html>
