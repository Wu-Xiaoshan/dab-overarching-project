---
import ExerciseDetail from "../../components/ExerciseDetail.svelte";
import AuthBar from "../../components/auth/AuthBar.svelte";

export const prerender = false;

const { id } = Astro.params;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Exercise</title>
  </head>
  <body>
    <AuthBar client:visible />
    <ExerciseDetail client:only="svelte" exerciseId={id} />
  </body>
</html>
